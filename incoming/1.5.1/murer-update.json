9a6fcc708dbb44f498735221","xgenius/__init__.py":"2272c464e982f670106fd6428f71e7b3837e73bd0a006b9d2e269db77b3fbb09","xgenius/accounts/__init__.py":"251421ac48ad283cd56879df54f2a1276908eb3d3cb3aa5434f8cec691ea65fe","xgenius/accounts/auth.py":"5019461a0bf4c3fd8eefcc09922eb25d6161b865ef68712a54cf305bccc4e699","xgenius/accounts/health.py":"abab574ab8a997929c50c7cffc491fc1d0e973d81c04780b135b26ac12f1974e","xgenius/accounts/manager.py":"f09234271d2e92122d90fdb72ace1987e3960b6e1f8d785458df5ccd0b91d433","xgenius/browser.py":"ee1a76d435ca41466fc92820bc1114d7c27aac29df40a920644635962cd2306a","xgenius/collectors/__init__.py":"2272c464e982f670106fd6428f71e7b3837e73bd0a006b9d2e269db77b3fbb09","xgenius/collectors/groups.py":"bab72dcf8584e5c03af641e16fdcaf4d168cf8f24972e2164e9e8152b7644832","xgenius/config.py":"ac4f42ee53b39790c6d5569e6bb33356ed77ff87b874b27d7d45f486f2f91610","xgenius/cookies.py":"df7776c81e861d6e2d9fb363d3be9a552f0531c94eb1886cf206cd4044826bb7","xgenius/core/__init__.py":"d0a4e96b282628a82e9def919095adbbb707c1d7cf040473aa5727958668d67b","xgenius/core/chat_list.py":"b84999b5c794517607a7a4a169773ff00fffd54e05a442b45506861c90b6af12","xgenius/core/dom.py":"e44c3c5bddb7e3f78de23ace93c9a0802924779a858dd6e3eb07e24e7d6e2c68","xgenius/core/network.py":"93a04ea95eb6b36368d915818f7181a535642433c3366dbec2f03c79f37452a9","xgenius/core/page_state.py":"e8b4a052bdeaed1bc428d9c68d37024a38da0872c389c8201df59d298976f7eb","xgenius/logger.py":"e502f37f4816ed09d172a8258425cfbbc02626718629ddbd917a5ea5b998aae9","xgenius/models.py":"f1f1f30a0816809fcfb3a860a03c64ab45bf2cfae1e74bd7d3e3b490e2b5220c","xgenius/process_utils.py":"8a4498810d107621e5ca94c8c54351f0970839385879d682e9ece047760d96c2","xgenius/settings.py":"9a7c23f4ada7f783c515b217c5784c368490181cde631d41ae4bcaba4c8e3814","xgenius/twitter/__init__.py":"2272c464e982f670106fd6428f71e7b3837e73bd0a006b9d2e269db77b3fbb09","xgenius/twitter/common.py":"a97af2d225e63f26bf84fd2c7b62050a7325a950a5cf27bf093a2392408c5fb2"},"notes":"# 1.5.0\n\n- Переключатель «Создавать пароль/PIN iChat автоматически» в карточке аккаунта и массовом назначении; по умолчанию выключен.\n- Первоначальное создание с одинаковым вводом пароля и подтверждения: две формы, два поля или цифровые сегменты. Используется отдельный пароль/PIN iChat из системного хранилища секретов.\n- Сброс, восстановление, проверочные коды и неподдерживаемые формы требуют ручного действия. После частичного ввода секрет автоматически не повторяется.\n- Экран настройки без полей больше не принимается за отсутствие блокировки.\n- Заметное уведомление в Trade и других разделах: аккаунт, причина и кнопка продолжения. Состояние восстанавливается после перезагрузки страницы и обновляется при потере фоновых событий.\n- Пароль и тумблер можно изменить во время ручного ожидания входа на дополнительном исходящем аккаунте, затем продолжить тот же Trade.\n- Ошибка подготовки показывается в карточке плана, даже если рабочий цикл уже завершился.\n- Подготовленный план сохраняется на экране после ручного продолжения и восстанавливается после перезагрузки страницы.\n\n# 1.4.1\n\n- Одна ссылка группы проверяется один раз для каждого стабильного ID получателя при подготовке, включая отклонённые группы на других аккаунтах. Пропуски видны в логах.\n- Подтверждённое участие запоминается между Trade; недавние подходящие группы повторно используются в пределах 15 минут при пересборке того же плана. Перед отправкой остаётся обязательная свежая проверка.\n- Серый результат поиска без галочки сохраняется как кандидат, ожидающий подписок, без лишнего чтения полного состава. После подписок доступность выбора перепроверяется.\n- Распознавание ошибок прокси при входе, поиске групп, чтении участников, профилей и Trade. Неисправный аккаунт получает статус «Ошибка прокси», без повторного перебора пароля/токенов и без потери сохранённых групп.\n- Полный состав общей группы в обычном задании сбора используется повторно между аккаунтами, в том числе при параллельном сборе. Неполные результаты не блокируют другой источник.\n\n# 1.4.0\n\n- Два этапа Trade: проверка точного плана и отдельный запуск после передачи ссылок получателю.\n- Свежая проверка стабильного ID, участия и доступности добавления в каждой выбранной группе, при любом фильтре качества.\n- Готовое сообщение со ссылками только на фактически выбранные исходящие аккаунты и таблица конкретных групп.\n- Проверка всех обратных подписок и всего плана до первого приглашения; без молчаливой замены групп или аккаунтов.\n- Обновление непустых устаревших списков при подготовке, запрет самопроизвольного частичного обмена.\n- Подтверждение конца контейнера чатов стабильными проверками; новый обмен блокируется при неполном начальном списке.\n- Явное ручное подтверждение входящих для старых неполных снимков и сверка исходящих в закрытых Trade.\n- Остановка ожидающего Trade сохраняет возможность продолжения; окончательное закрытие — отдельное действие.\n- Ожидание кнопки добавления использует полный бюджет проверок вместо преждевременного ограничения группы.\n\n# 1.3.0\n\n- На странице Trade появился отдельный блок скорости: «Медленная», «Средняя», «Быстрая» и ручные значения.\n- Независимые паузы действий, контрагентов, добавлений и запуска аккаунтов; настройки входа, загрузки и прокрутки чатов.\n- Отдельное включение и диапазоны хьюманизации Trade, без изменения автосбора.\n- Режимы скорости сохраняют таймауты, бюджет проверок подтверждения и предел поиска чатов.\n- Автосохранение с проверкой значений, сбросом полей и защитой от перезаписи из другого окна.\n- Скорость фиксируется при запуске / продолжении, сохраняется в истории и логах; активный шаг использует прежние значения.\n- Сохранение настроек сбора больше не перезаписывает независимые настройки Trade.\n\n# 1.2.1\n\n- Trade ждёт подтверждённый выбор пользователя и готовность кнопки после перерисовки XChat.\n- Обрабатывает дополнительное подтверждение после «Далее» и дожидается завершения формы перед переходом.\n- Сверяет участие несколько раз при задержке ответа X, без повторной отправки приглашения.\n- При неизвестном результате сохраняет браузер отправителя открытым и предлагает проверку результата; остановка сохраняет неподтверждённую попытку.\n- Продолжение старого Trade сначала сверяет сохранённые попытки. Ошибки до отправки повторяются ограниченное число раз.\n- Убраны лишние предварительные входы в исходящие аккаунты. Явно добавленный аккаунт обрабатывается первым даже без сохранённых групп.\n- Ограничение добавления для пары группа–аккаунт перепроверяется после 15 минут; ошибки загрузки не выдаются за нехватку аккаунтов.\n- В логах появились отдельные этапы выбора, отправки, подтверждения и сверки приглашения.\n\n# 1.2.0\n\n- Раздел «Логи»: вкладки системы, входа, браузера, сбора, Trade, данных, обновлений и ошибок.\n- Одновременный выбор типов событий, уровней и аккаунтов, поиск и фильтр задания.\n- Подробная запись этапов, команд браузера, прогресса, кеша, повторов, сохранений и результатов операций.\n- Автоматическое обновление просмотра, пауза просмотра, стабильная навигация по истории и выгрузка JSONL.\n- Локальное хранение последних 20 000 событий за 14 дней; скрытие секретов до записи.\n- При недоступном диске программа продолжает работу, показывает предупреждение и временно хранит последние 500 событий в памяти.\n\n# 1.1.0\n\n- Проверка GitHub Releases вручную и автоматически при запуске и каждые 6 часов.\n- Скачивание подписанных обновлений, установка отдельной версии и перезапуск.\n- Резервная копия SQLite, проверка новой версии до разрешения действий и автоматическое восстановление при ошибке запуска.\n- Возврат предыдущей версии при совместимой схеме базы.\n- Публичные обновления из MSortGroups-Releases без аккаунта GitHub и без токенов.\n- Дополнительная поддержка приватных релизов с доступом через Windows Credential Manager.","package":{"name":"MurerGroupStats-1.5.1.zip","sha256":"4507550ab3b1f8cd6aff5b4b25628c80b5ad87f1d264cc3b2cd6b2d6fa3e4660","size":742864},"python_min":"3.11","schema":1,"updater_protocol":1,"version":"1.5.1"}